"""Verify /api/energy_range_live against a brute-force 40-iteration bisection."""
import sys, time, json; sys.path.append('.')
from server import app, SELLERS, BUYERS, PLAYER_LOCATIONS, run_case, bus_idx, ACTUAL_LOAD_DATA

c = app.test_client()

def brute(s_shape, b_vec, hi=200.0):
    """Ground truth: 40-iteration bisection on total seller injection."""
    lo = 0.0
    for _ in range(40):
        mid = (lo + hi) / 2
        r = run_case("POST_MATCH", SELLERS, BUYERS, PLAYER_LOCATIONS,
                     buyer_energy_kwh=dict(b_vec),
                     seller_sold_kwh={s: 0.0 for s in SELLERS},
                     seller_unsold_kwh={k: mid * w for k, w in s_shape.items()})
        v = r.get("violations", {})
        good = r.get("converged") and not (v["over"] or v["under"] or v["thermal"])
        lo, hi = (mid, hi) if good else (lo, mid)
    return lo

def brute_buyer(s_vec, b_shape, hi=300.0):
    lo = 0.0
    for _ in range(40):
        mid = (lo + hi) / 2
        r = run_case("POST_MATCH", SELLERS, BUYERS, PLAYER_LOCATIONS,
                     buyer_energy_kwh={k: mid * w for k, w in b_shape.items()},
                     seller_sold_kwh={s: 0.0 for s in SELLERS},
                     seller_unsold_kwh=dict(s_vec))
        v = r.get("violations", {})
        good = r.get("converged") and not (v["over"] or v["under"] or v["thermal"])
        lo, hi = (mid, hi) if good else (lo, mid)
    return lo

